<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NULipaInternshipTracker.Views.ForgotPasswordPage"
             BackgroundColor="#F4F6F9"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *" Padding="20, 24, 20, 16">

        <!-- Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
            <Button Grid.Column="0" Text="←" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" BackgroundColor="Transparent" Padding="0" WidthRequest="32" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1">
                <Label Text="ACCOUNT RECOVERY" FontFamily="MontserratBold" FontSize="9" TextColor="#fbd117" CharacterSpacing="1.2"/>
                <Label Text="Reset Password" FontFamily="MontserratBold" FontSize="19" TextColor="#32418c"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Form Container -->
        <ScrollView Grid.Row="1" Margin="0, 14, 0, 0">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <!-- Portal Selector -->
                    <Border BackgroundColor="#E2E8F0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="3">
                        <Grid ColumnDefinitions="*, *">
                            <Button x:Name="btnTabStudent" Text="Student Account" FontFamily="MontserratBold" FontSize="11" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="32" Clicked="OnTabStudentClicked"/>
                            <Button x:Name="btnTabCompany" Grid.Column="1" Text="Company Recruiter" FontFamily="MontserratBold" FontSize="11" BackgroundColor="Transparent" TextColor="#475569" CornerRadius="8" HeightRequest="32" Clicked="OnTabCompanyClicked"/>
                        </Grid>
                    </Border>

                    <!-- Student Verification Inputs -->
                    <VerticalStackLayout x:Name="layoutStudentForm" Spacing="10" IsVisible="True">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Student Full Name *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryStudentName" 
                                       Placeholder="Juan Dela Cruz" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Student Email Address *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryStudentEmail" 
                                       Placeholder="jdelacruz@students.nu-lipa.edu.ph" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       Keyboard="Email" 
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Student ID Number *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryStudentNo" 
                                       Placeholder="2023-123456" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Company Recruiter Verification Inputs -->
                    <VerticalStackLayout x:Name="layoutCompanyForm" Spacing="10" IsVisible="False">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Registered Company Name *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryCompanyName" 
                                       Placeholder="e.g. Canva Philippines" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Recruiter Full Name *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryRecruiterName" 
                                       Placeholder="HR Manager Full Name" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Recruiter Official Work Email *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryCompanyEmail" 
                                       Placeholder="recruiter@canva.com" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       Keyboard="Email" 
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Company ID / Reference Code *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryCompanyCode" 
                                       Placeholder="e.g. COMP-101" 
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       TextColor="#1E293B" 
                                       FontFamily="MontserratRegular" 
                                       FontSize="12" 
                                       HeightRequest="38"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0, 4"/>

                    <!-- New Password Input -->
                    <VerticalStackLayout Spacing="3">
                        <Label Text="New Account Password *" FontFamily="MontserratSemiBold" FontSize="10.5" TextColor="#32418c"/>
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                            <Entry x:Name="entryNewPassword" 
                                   IsPassword="True" 
                                   Placeholder="Minimum 6 characters" 
                                   PlaceholderColor="#94A3B8"
                                   BackgroundColor="Transparent"
                                   TextColor="#1E293B" 
                                   FontFamily="MontserratRegular" 
                                   FontSize="12" 
                                   HeightRequest="38"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Verify Identity &amp; Reset Password" 
                            FontFamily="MontserratBold" 
                            FontSize="11.5" 
                            BackgroundColor="#32418c" 
                            TextColor="#FFFFFF" 
                            CornerRadius="10" 
                            HeightRequest="42" 
                            Margin="0, 6, 0, 0" 
                            Clicked="OnResetPasswordClicked"/>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>