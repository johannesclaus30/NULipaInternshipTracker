<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NULipaInternshipTracker.Views.WelcomePage"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">
        <!-- Top Blue NU Banner & Profile -->
        <Border Grid.Row="0" 
                BackgroundColor="#32418c" 
                StrokeThickness="0" 
                Margin="0,0,0,-40"
                StrokeShape="RoundRectangle 0,0,40,40"
                VerticalOptions="Fill">

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-40,0,0">
                <!-- Profile Avatar Ring -->
                <Border WidthRequest="110" HeightRequest="110" 
                        Stroke="#fbd117" StrokeThickness="4" 
                        BackgroundColor="#FFFFFF" 
                        StrokeShape="RoundRectangle 55"
                        HorizontalOptions="Center">
                    <Label Text="👤" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Profile Info -->
                <Label Text="Welcome!" 
                       FontFamily="MontserratBold" 
                       FontSize="54" 
                       TextColor="#FFFFFF" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,0" />

                <Label Text="BS Information Technology • 3rd Year" 
                       FontFamily="MontserratMedium" 
                       FontSize="13" 
                       TextColor="#fbd117" 
                       HorizontalOptions="Center" />

                <Label Text="NU Lipa Internship Tracker" 
                       FontFamily="MontserratRegular" 
                       FontSize="12" 
                       TextColor="#D4E2EE" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Bottom Action Card -->
        <Border Grid.Row="1" 
                BackgroundColor="#FFFFFF" 
                Padding="24, 40, 24, 40" 
                Margin="20, 0, 20, 100"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.08" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">
                <Label Text="Ready to track your OJT hunt?" 
                       FontFamily="MontserratBold" 
                       FontSize="18" 
                       TextColor="#32418c" 
                       HorizontalOptions="Center" />

                <Button Text="Open Internship Tracker" 
                        FontFamily="MontserratBold" 
                        FontSize="14" 
                        BackgroundColor="#fbd117" 
                        TextColor="#32418c" 
                        CornerRadius="14" 
                        HeightRequest="54" 
                        Clicked="OnOpenTrackerClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>