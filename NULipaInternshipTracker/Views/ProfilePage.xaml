<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NULipaInternshipTracker.Views.ProfilePage"
             BackgroundColor="#F4F6F9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *" Padding="16, 20, 16, 16">

        <!-- Top Navigation Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
            <Button Grid.Column="0" Text="←" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" BackgroundColor="Transparent" Padding="0" WidthRequest="32" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="My Profile" FontFamily="MontserratBold" FontSize="20" TextColor="#32418c" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Sign Out" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#DC2626" BackgroundColor="#FEE2E2" CornerRadius="8" HeightRequest="32" Padding="10, 0" Clicked="OnSignOutClicked" />
        </Grid>

        <!-- Profile Form -->
        <ScrollView Grid.Row="1" Margin="0, 14, 0, 0">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <!-- Profile Photo / Avatar -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0, 6, 0, 10">
                        <Border HeightRequest="90" WidthRequest="90" 
                                StrokeShape="RoundRectangle 45" 
                                Stroke="#32418c" 
                                StrokeThickness="2" 
                                BackgroundColor="#EEF2F6" 
                                HorizontalOptions="Center">
                            <Grid>
                                <Label x:Name="lblAvatarPlaceholder" Text="👤" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image x:Name="imgProfileAvatar" Aspect="AspectFill" IsVisible="False" />
                            </Grid>
                        </Border>

                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Button Text="Change Photo" FontFamily="MontserratSemiBold" FontSize="10" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="30" Padding="12, 0" Clicked="OnChangePhotoClicked" />
                            <Button Text="Remove" FontFamily="MontserratSemiBold" FontSize="10" BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="8" HeightRequest="30" Padding="12, 0" Clicked="OnRemovePhotoClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Full Name *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                            <Entry x:Name="entryName" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email Address *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                            <Entry x:Name="entryEmail" TextColor="#1E293B" Keyboard="Email" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Student ID Number *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                            <Entry x:Name="entryStudentId" Placeholder="e.g. 2023-100234" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="New Password (leave blank to keep current)" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                            <Entry x:Name="entryPassword" IsPassword="True" Placeholder="••••••••" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Save Changes -->
                    <Button Text="Save Changes" FontFamily="MontserratBold" FontSize="12" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="44" Margin="0, 10, 0, 0" Clicked="OnSaveClicked" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>