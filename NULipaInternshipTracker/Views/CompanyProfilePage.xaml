<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NULipaInternshipTracker.Views.CompanyProfilePage"
             BackgroundColor="#F4F6F9"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, *" Padding="16, 20, 16, 16" RowSpacing="12">

        <!-- Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
            <Button Grid.Column="0" Text="←" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" BackgroundColor="Transparent" Padding="0" WidthRequest="32" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Company &amp; Recruiter Settings" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" VerticalOptions="Center" />
        </Grid>

        <!-- Segment Tabs -->
        <Border Grid.Row="1" BackgroundColor="#E2E8F0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="3">
            <Grid ColumnDefinitions="*, *">
                <Button x:Name="btnTabCompany" Text="🏢 Company Entity" FontFamily="MontserratBold" FontSize="11" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="34" Clicked="OnTabCompanyClicked" />
                <Button x:Name="btnTabRecruiter" Grid.Column="1" Text="👤 Recruiter Account" FontFamily="MontserratBold" FontSize="11" BackgroundColor="Transparent" TextColor="#475569" CornerRadius="8" HeightRequest="34" Clicked="OnTabRecruiterClicked" />
            </Grid>
        </Border>

        <!-- Dynamic Tab Content -->
        <ScrollView Grid.Row="2">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <!-- TAB 1: COMPANY ENTITY & LOGO -->
                    <VerticalStackLayout x:Name="layoutCompanyTab" Spacing="14" IsVisible="True">
                        <!-- Logo Section -->
                        <Label Text="Official Company Logo" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                        <Border HeightRequest="100" WidthRequest="180" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                            <Grid>
                                <Label x:Name="lblLogoPlaceholder" Text="No Logo Uploaded" FontFamily="MontserratMedium" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image x:Name="imgLogoPreview" Aspect="AspectFit" Margin="6" IsVisible="False" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Text="Upload Logo" FontFamily="MontserratSemiBold" FontSize="11" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="34" Clicked="OnUploadLogoClicked" />
                            <Button Grid.Column="1" Text="Remove" FontFamily="MontserratSemiBold" FontSize="11" BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="8" HeightRequest="34" Clicked="OnRemoveLogoClicked" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Company Registered Name *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryCompanyName" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- TAB 2: RECRUITER ACCOUNT -->
                    <VerticalStackLayout x:Name="layoutRecruiterTab" Spacing="14" IsVisible="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Recruiter / HR Full Name *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryRecruiterName" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Official Recruiter Work Email *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryEmail" TextColor="#1E293B" Keyboard="Email" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- In Company Tab -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Company ID / Reference Code *" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryCompanyCode" Placeholder="e.g. COMP-101" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="New Password (leave blank to keep current)" FontFamily="MontserratSemiBold" FontSize="11" TextColor="#32418c" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10, 0">
                                <Entry x:Name="entryPassword" IsPassword="True" Placeholder="••••••••" TextColor="#1E293B" BackgroundColor="Transparent" FontFamily="MontserratRegular" FontSize="12.5" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Common Save Button -->
                    <Button Text="Save Settings" FontFamily="MontserratBold" FontSize="12" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="44" Margin="0, 10, 0, 0" Clicked="OnSaveClicked" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>