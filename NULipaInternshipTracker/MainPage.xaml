<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NULipaInternshipTracker.Models"
             x:Class="NULipaInternshipTracker.MainPage"
             BackgroundColor="#F4F6F9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="16,16,16,12" RowSpacing="14">
        <!-- 0. Header with "My Applications" button -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="NATIONAL UNIVERSITY LIPA" FontFamily="MontserratBold" FontSize="9" TextColor="#fbd117" CharacterSpacing="1.2" />
                <Label Text="Internship Listings" FontFamily="MontserratBold" FontSize="20" TextColor="#32418c" LineHeight="1" />
            </VerticalStackLayout>

            <!-- My Applications - Pill secondary button -->
            <Border Grid.Column="1" HeightRequest="44" Padding="14,0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1.2" StrokeShape="RoundRectangle 22">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                </Border.Shadow>
                <Grid ColumnSpacing="6" ColumnDefinitions="Auto, Auto">
                    <Label Grid.Column="0" Text="📋" FontSize="12" VerticalOptions="Center" TextColor="#32418c"/>
                    <Label Grid.Column="1" Text="My Applications" FontSize="11" FontFamily="MontserratBold" TextColor="#32418c" VerticalOptions="Center"/>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" Padding="0" Clicked="OnMyApplicationsClicked">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.94"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </Grid>
            </Border>

            <!-- Refresh Button - Circular white -->
            <Border Grid.Column="2" HeightRequest="44" WidthRequest="44" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1.2" StrokeShape="RoundRectangle 22">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
                </Border.Shadow>
                <Grid>
                    <Label Text="↻" FontSize="20" FontFamily="MontserratBold" TextColor="#32418c" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-1,0,0"/>
                    <Button BackgroundColor="Transparent" Command="{Binding RefreshCommand}" Padding="0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.88"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </Grid>
            </Border>

            <!-- Profile Button - Circular Avatar / Initials -->
            <Border Grid.Column="3" HeightRequest="44" WidthRequest="44" BackgroundColor="#fbd117" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                <Border.Shadow>
                    <Shadow Brush="#fbd117" Offset="0,4" Radius="12" Opacity="0.40" />
                </Border.Shadow>
                <Grid>
                    <!-- Fallback Initials (Shown when no photo is set) -->
                    <Label x:Name="lblUserInitials" Text="NU" FontFamily="MontserratBold" FontSize="13" TextColor="#32418c" HorizontalOptions="Center" VerticalOptions="Center"/>

                    <!-- Real Profile Photo (Shown when set) -->
                    <Image x:Name="imgUserProfile" Aspect="AspectFill" IsVisible="False" Clip="{RoundRectangleGeometry CornerRadius='22', Rect='0,0,44,44'}" />

                    <Button BackgroundColor="Transparent" Clicked="OnProfileClicked" Padding="0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.88"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 1. Stats Counter Row -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
            <Border Grid.Column="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="0,10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding TotalAvailable}" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" HorizontalOptions="Center"/>
                    <Label Text="OPENINGS" FontFamily="MontserratBold" FontSize="7.5" TextColor="#64748B" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="#32418c" StrokeThickness="0" Padding="0,10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#32418c" Offset="0,4" Radius="10" Opacity="0.22" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding AppliedCount}" FontFamily="MontserratBold" FontSize="18" TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="APPLIED" FontFamily="MontserratBold" FontSize="7.5" TextColor="#BFCAFF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#fbd117" StrokeThickness="0" Padding="0,10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#fbd117" Offset="0,4" Radius="10" Opacity="0.35" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding InterviewCount}" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" HorizontalOptions="Center"/>
                    <Label Text="INTERVIEWS" FontFamily="MontserratBold" FontSize="7.5" TextColor="#5A4A00" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="3" BackgroundColor="#10B981" StrokeThickness="0" Padding="0,10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#10B981" Offset="0,4" Radius="10" Opacity="0.28" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding OffersAccepted}" FontFamily="MontserratBold" FontSize="18" TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="ACCEPTED" FontFamily="MontserratBold" FontSize="7.5" TextColor="#D1FAE5" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 2. Search Bar -->
        <Border Grid.Row="2" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="12,0" StrokeShape="RoundRectangle 14">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.05" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                <Label Grid.Column="0" Text="🔍" FontSize="12" VerticalOptions="Center" TextColor="#94A3B8"/>
                <SearchBar Grid.Column="1" Placeholder="Search company, role, or skill..." PlaceholderColor="#94A3B8" TextColor="#32418c" FontFamily="MontserratRegular" FontSize="12.5" BackgroundColor="Transparent" TextChanged="OnSearchTextChanged" HeightRequest="42"/>
            </Grid>
        </Border>

        <!-- 3. Filter Chips (Added HYBRID chip) -->
        <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="All Openings" Clicked="OnFilterChipClicked" CommandParameter="All" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="20" HeightRequest="34" Padding="16,0" BackgroundColor="#32418c" TextColor="#FFFFFF" BorderWidth="1" BorderColor="#32418c"/>
                <Button Text="Remote" Clicked="OnFilterChipClicked" CommandParameter="Remote" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="20" HeightRequest="34" Padding="16,0" BackgroundColor="#FFFFFF" TextColor="#475569" BorderWidth="1" BorderColor="#E2E8F0"/>
                <Button Text="Hybrid" Clicked="OnFilterChipClicked" CommandParameter="Hybrid" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="20" HeightRequest="34" Padding="16,0" BackgroundColor="#FFFFFF" TextColor="#475569" BorderWidth="1" BorderColor="#E2E8F0"/>
                <Button Text="Onsite" Clicked="OnFilterChipClicked" CommandParameter="Onsite" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="20" HeightRequest="34" Padding="16,0" BackgroundColor="#FFFFFF" TextColor="#475569" BorderWidth="1" BorderColor="#E2E8F0"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 4. Job Postings Grid -->
        <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView x:Name="PostingsCollection" ItemsSource="{Binding Postings}" SelectionMode="None" VerticalOptions="Fill">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobPosting">
                        <Border BackgroundColor="#FFFFFF" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 16" 
                                Padding="10">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="5">

                                <!-- Row 0: Logo & Top Status Tag -->
                                <Border Grid.Row="0" 
                                        HeightRequest="65" 
                                        StrokeShape="RoundRectangle 10" 
                                        BackgroundColor="#F8FAFC" 
                                        Stroke="#EEF2F6" 
                                        StrokeThickness="1">
                                    <Grid>
                                        <Label Text="🏢" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasNoLogo}"/>
                                        <Image Source="{Binding LogoSource}" Aspect="AspectFit" Margin="6" IsVisible="{Binding HasLogo}"/>

                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="5" Padding="6,2" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#EEF2F6" IsVisible="{Binding HasApplied}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Applied">
                                                    <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="For Interview">
                                                    <Setter Property="BackgroundColor" Value="#FEF9C3"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Interview">
                                                    <Setter Property="BackgroundColor" Value="#FEF9C3"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Rejected">
                                                    <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Accepted">
                                                    <Setter Property="BackgroundColor" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Offer">
                                                    <Setter Property="BackgroundColor" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Offer / MOA">
                                                    <Setter Property="BackgroundColor" Value="#D1FAE5"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding StudentApplicationStage}" FontFamily="MontserratBold" FontSize="7.5">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Applied">
                                                        <Setter Property="TextColor" Value="#1E40AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="For Interview">
                                                        <Setter Property="TextColor" Value="#854D0E"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Interview">
                                                        <Setter Property="TextColor" Value="#854D0E"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Rejected">
                                                        <Setter Property="TextColor" Value="#991B1B"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Accepted">
                                                        <Setter Property="TextColor" Value="#065F46"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Offer">
                                                        <Setter Property="TextColor" Value="#065F46"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Offer / MOA">
                                                        <Setter Property="TextColor" Value="#065F46"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Company & Role -->
                                <VerticalStackLayout Grid.Row="1" Spacing="1" Margin="2,0">
                                    <Label Text="{Binding CompanyName}" FontFamily="MontserratBold" FontSize="12" TextColor="#1E293B" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding RoleTitle}" FontFamily="MontserratMedium" FontSize="10" TextColor="#475569" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="28" VerticalTextAlignment="Start"/>
                                </VerticalStackLayout>

                                <!-- Row 2: Setup & Salary Badges -->
                                <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="2,0">
                                    <FlexLayout Direction="Row" Wrap="Wrap">
                                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="6,2" Margin="0,0,4,0">
                                            <Label Text="{Binding WorkSetup}" FontFamily="MontserratSemiBold" FontSize="7.5" TextColor="#475569"/>
                                        </Border>
                                        <Border BackgroundColor="#FEF9C3" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="6,2">
                                            <Label Text="{Binding Salary}" FontFamily="MontserratBold" FontSize="7.5" TextColor="#854D0E"/>
                                        </Border>
                                    </FlexLayout>
                                    <Label Text="{Binding PostedDate, StringFormat='🕒 {0}'}" FontFamily="MontserratRegular" FontSize="7.5" TextColor="#94A3B8"/>
                                </VerticalStackLayout>

                                <!-- Row 3: Description Preview -->
                                <Border Grid.Row="3" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,4" HeightRequest="26">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowDescriptionCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="{Binding PreviewDescription}" FontFamily="MontserratRegular" FontSize="8.5" TextColor="#64748B" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="more" FontFamily="MontserratBold" FontSize="8" TextColor="#32418c" IsVisible="{Binding IsLongDescription}" VerticalOptions="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Row 4: Action Button -->
                                <Grid Grid.Row="4" Margin="0,2,0,0">
                                    <Button Text="Apply Now" 
                                            FontFamily="MontserratBold" 
                                            FontSize="10" 
                                            BackgroundColor="#32418c" 
                                            TextColor="#FFFFFF" 
                                            CornerRadius="8" 
                                            HeightRequest="30" 
                                            Padding="0" 
                                            IsVisible="{Binding CanApply}" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplyCommand}" 
                                            CommandParameter="{Binding .}"/>

                                    <Button Text="✓ Accept Offer" 
                                            FontFamily="MontserratBold" 
                                            FontSize="10" 
                                            BackgroundColor="#10B981" 
                                            TextColor="#FFFFFF" 
                                            CornerRadius="8" 
                                            HeightRequest="30" 
                                            Padding="0" 
                                            IsVisible="{Binding IsOfferStage}" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptOfferCommand}" 
                                            CommandParameter="{Binding .}"/>

                                    <Border StrokeThickness="0" 
                                            StrokeShape="RoundRectangle 8" 
                                            HeightRequest="30" 
                                            Padding="6,0" 
                                            VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding HasApplied}" Value="False">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOfferStage}" Value="True">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Applied">
                                                <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="For Interview">
                                                <Setter Property="BackgroundColor" Value="#FEF9C3"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Interview">
                                                <Setter Property="BackgroundColor" Value="#FEF9C3"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Rejected">
                                                <Setter Property="BackgroundColor" Value="#FEE2E2"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding StudentApplicationStage}" Value="Accepted">
                                                <Setter Property="BackgroundColor" Value="#D1FAE5"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding StudentApplicationStage}" FontFamily="MontserratBold" FontSize="9.5" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Applied">
                                                    <Setter Property="TextColor" Value="#1E40AF"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="For Interview">
                                                    <Setter Property="TextColor" Value="#854D0E"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Interview">
                                                    <Setter Property="TextColor" Value="#854D0E"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Rejected">
                                                    <Setter Property="TextColor" Value="#991B1B"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding StudentApplicationStage}" Value="Accepted">
                                                    <Setter Property="TextColor" Value="#065F46"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>