<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NULipaInternshipTracker.Models"
             x:Class="NULipaInternshipTracker.MainPage"
             BackgroundColor="#F4F6F9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" 
          Padding="16, 20, 16, 12" 
          RowSpacing="14">

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
            <Button Grid.Column="0" Text="←" FontFamily="MontserratBold" FontSize="18" TextColor="#32418c" BackgroundColor="Transparent" Padding="0" WidthRequest="28" Clicked="OnBackToProfileClicked" />

            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="CAREER PORTAL" FontFamily="MontserratBold" FontSize="9" TextColor="#fbd117" CharacterSpacing="1.2" />
                <Label Text="OJT Tracker" FontFamily="MontserratBold" FontSize="20" TextColor="#32418c" />
            </VerticalStackLayout>

            <!-- Refresh Button -->
            <Button Grid.Column="2" Text="🔄" FontSize="13" BackgroundColor="#FFFFFF" TextColor="#32418c" CornerRadius="10" HeightRequest="38" WidthRequest="38" Padding="0" Command="{Binding RefreshCommand}">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,3" Radius="8" Opacity="0.05" />
                </Button.Shadow>
            </Button>

            <!-- + New Application Button -->
            <Button Grid.Column="3" Text="+ New" FontFamily="MontserratSemiBold" FontSize="12" BackgroundColor="#32418c" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="38" Padding="12, 0" Command="{Binding AddCommand}">
                <Button.Shadow>
                    <Shadow Brush="#32418c" Offset="0,3" Radius="10" Opacity="0.25" />
                </Button.Shadow>
            </Button>

            <!-- Profile & Settings Button -->
            <Button Grid.Column="4" Text="👤" FontSize="15" BackgroundColor="#fbd117" TextColor="#32418c" CornerRadius="10" HeightRequest="38" WidthRequest="38" Padding="0" Clicked="OnProfileClicked">
                <Button.Shadow>
                    <Shadow Brush="#fbd117" Offset="0,3" Radius="8" Opacity="0.35" />
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- 2. Stat Counters (3-Column Layout) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *" ColumnSpacing="8">
            <!-- 1. Total Applied -->
            <Border Grid.Column="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="10, 10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding TotalApplied}" FontFamily="MontserratBold" FontSize="20" TextColor="#32418c" HorizontalOptions="Center" />
                    <Label Text="SUBMITTED" FontFamily="MontserratBold" FontSize="8" TextColor="#64748B" CharacterSpacing="0.8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Interviews -->
            <Border Grid.Column="1" BackgroundColor="#32418c" StrokeThickness="0" Padding="10, 10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#32418c" Offset="0,3" Radius="8" Opacity="0.2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding InterviewsSecured}" FontFamily="MontserratBold" FontSize="20" TextColor="#fbd117" HorizontalOptions="Center" />
                    <Label Text="INTERVIEW" FontFamily="MontserratBold" FontSize="8" TextColor="#D4E2EE" CharacterSpacing="0.8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Accepted / Offers -->
            <Border Grid.Column="2" BackgroundColor="#10B981" StrokeThickness="0" Padding="10, 10" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#10B981" Offset="0,3" Radius="8" Opacity="0.25" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="{Binding OffersAccepted}" FontFamily="MontserratBold" FontSize="20" TextColor="#FFFFFF" HorizontalOptions="Center" />
                    <Label Text="ACCEPTED" FontFamily="MontserratBold" FontSize="8" TextColor="#D1FAE5" CharacterSpacing="0.8" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 3. Search Bar -->
        <Border Grid.Row="2" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="6, 0" StrokeShape="RoundRectangle 12">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
            </Border.Shadow>
            <SearchBar Placeholder="Search company or role..." PlaceholderColor="#94A3B8" TextColor="#32418c" FontFamily="MontserratRegular" FontSize="12" BackgroundColor="Transparent" TextChanged="OnSearchTextChanged" HeightRequest="40" />
        </Border>

        <!-- 4. Stage Filter Chips (Includes Accepted) -->
        <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="All" Clicked="OnFilterChipClicked" CommandParameter="All" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="16" HeightRequest="32" Padding="14, 0" BackgroundColor="#32418c" TextColor="#FFFFFF" />
                <Button Text="Accepted" Clicked="OnFilterChipClicked" CommandParameter="Accepted" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="16" HeightRequest="32" Padding="14, 0" BackgroundColor="#FFFFFF" TextColor="#475569" />
                <Button Text="Offer / MOA" Clicked="OnFilterChipClicked" CommandParameter="Offer / MOA" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="16" HeightRequest="32" Padding="14, 0" BackgroundColor="#FFFFFF" TextColor="#475569" />
                <Button Text="Applied" Clicked="OnFilterChipClicked" CommandParameter="Applied" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="16" HeightRequest="32" Padding="14, 0" BackgroundColor="#FFFFFF" TextColor="#475569" />
                <Button Text="Interview" Clicked="OnFilterChipClicked" CommandParameter="Interview" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="16" HeightRequest="32" Padding="14, 0" BackgroundColor="#FFFFFF" TextColor="#475569" />
                <Button Text="Rejected" Clicked="OnFilterChipClicked" CommandParameter="Rejected" FontFamily="MontserratSemiBold" FontSize="11" CornerRadius="16" HeightRequest="32" Padding="14, 0" BackgroundColor="#FFFFFF" TextColor="#475569" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 5. 2-COLUMN PORTRAIT GRID -->
        <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView x:Name="ApplicationsCollection" ItemsSource="{Binding Applications}" SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" 
                                     Span="2" 
                                     HorizontalItemSpacing="12" 
                                     VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Padding="0, 50, 0, 0">
                        <Label Text="🏢" FontSize="36" HorizontalOptions="Center" Opacity="0.5" />
                        <Label Text="No applications found" FontFamily="MontserratSemiBold" FontSize="14" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobApplication">
                        <Border BackgroundColor="#FFFFFF" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 16"
                                Padding="10">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.05" />
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="6">

                                <!-- Row 0: Logo Banner & Stage Badge -->
                                <Border Grid.Row="0"
                                        HeightRequest="96"
                                        HorizontalOptions="Fill"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#FFFFFF"
                                        Stroke="#EEF2F6"
                                        StrokeThickness="1">
                                    <Grid>
                                        <!-- 1. Fallback Placeholder: Only exists visually when HasNoLogo is true -->
                                        <VerticalStackLayout HorizontalOptions="Center" 
                                                             VerticalOptions="Center" 
                                                             IsVisible="{Binding HasNoLogo}">
                                            <Label Text="🏢" 
                                                   FontSize="34" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center" />
                                        </VerticalStackLayout>

                                        <!-- 2. Logo Container: Completely covers the background with pure white when HasLogo is true -->
                                        <Border BackgroundColor="#FFFFFF"
                                                StrokeThickness="0"
                                                IsVisible="{Binding HasLogo}">
                                            <Image Source="{Binding LogoSource}" 
                                                   Aspect="AspectFit" 
                                                   Margin="8" />
                                        </Border>

                                        <!-- 3. Floating Stage Badge -->
                                        <Border HorizontalOptions="End" 
                                                VerticalOptions="Start" 
                                                Margin="6" 
                                                BackgroundColor="#EEF2F6" 
                                                StrokeThickness="0" 
                                                Padding="6, 2" 
                                                StrokeShape="RoundRectangle 8">
                                            <Label Text="{Binding Stage}" 
                                                   FontFamily="MontserratBold" 
                                                   FontSize="8" 
                                                   TextColor="#32418c" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Company & Role -->
                                <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="2, 2, 2, 0">
                                    <Label Text="{Binding CompanyName}" 
                                           FontFamily="MontserratBold" 
                                           FontSize="13" 
                                           TextColor="#32418c" 
                                           LineBreakMode="TailTruncation" />

                                    <Label Text="{Binding RoleTitle}" 
                                           FontFamily="MontserratMedium" 
                                           FontSize="11" 
                                           TextColor="#475569" 
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Row 2: Setup & Stipend -->
                                <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="2, 0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6, 2">
                                            <Label Text="{Binding WorkSetup}" FontFamily="MontserratMedium" FontSize="8" TextColor="#64748B" />
                                        </Border>

                                        <Border BackgroundColor="#FEF9C3" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6, 2">
                                            <Label Text="{Binding ExpectedSalary}" FontFamily="MontserratBold" FontSize="8" TextColor="#854D0E" MaxLines="1" LineBreakMode="TailTruncation" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding ApplicationDate, StringFormat='📅 {0}'}" 
                                           FontFamily="MontserratRegular" 
                                           FontSize="9" 
                                           TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <!-- Row 3: Notes Preview (Fixed Height, Truncated) -->
                                <Border Grid.Row="3"
        BackgroundColor="#F8FAFC"
        Stroke="#E2E8F0"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="8, 6"
        Margin="0, 2, 0, 0">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Notes}" Value="">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Notes}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" 
               Text="📝" 
               FontSize="10" 
               VerticalOptions="Center" />

                                        <!-- Fixed to 2 lines so the card structure never distorts -->
                                        <Label Grid.Column="1" 
               Text="{Binding Notes}" 
               FontFamily="MontserratRegular" 
               FontSize="9" 
               TextColor="#64748B" 
               MaxLines="2" 
               LineBreakMode="TailTruncation"
               VerticalOptions="Center" />

                                        <!-- View Full Note Button -->
                                        <Button Grid.Column="2"
                                                Text="more..."
                                                Clicked="OnViewFullNotesClicked"
                                                FontFamily="MontserratSemiBold"
                                                FontSize="8"
                                                TextColor="#32418c"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                HeightRequest="18"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Row 4: Action Buttons (With Dynamic Accept Button for Offers) -->
                                <VerticalStackLayout Grid.Row="4" Spacing="6" Margin="0, 4, 0, 2">

                                    <!-- 1. Accept Button (ONLY visible when Stage == 'Offer / MOA') -->
                                    <Button Text="✓ Accept Offer" 
            FontFamily="MontserratBold" 
            FontSize="10" 
            BackgroundColor="#10B981" 
            TextColor="#FFFFFF" 
            CornerRadius="8" 
            HeightRequest="30" 
            Padding="0" 
            IsVisible="{Binding IsOfferStage}"
            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptOfferCommand}" 
            CommandParameter="{Binding .}">
                                        <Button.Shadow>
                                            <Shadow Brush="#10B981" Offset="0,2" Radius="6" Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>

                                    <!-- 2. Standard Edit & Del Buttons -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                                        <Button Grid.Column="0" 
                Text="Edit" 
                FontFamily="MontserratSemiBold" 
                FontSize="10" 
                BackgroundColor="#F4F6F9" 
                TextColor="#32418c" 
                CornerRadius="8" 
                HeightRequest="28" 
                Padding="0" 
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" 
                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="1" 
                Text="Del" 
                FontFamily="MontserratSemiBold" 
                FontSize="10" 
                BackgroundColor="#FEE2E2" 
                TextColor="#DC2626" 
                CornerRadius="8" 
                HeightRequest="28" 
                Padding="0" 
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" 
                CommandParameter="{Binding .}" />
                                    </Grid>

                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>