<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NULipaInternshipTracker"
             x:Class="NULipaInternshipTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Font Overrides -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="MontserratRegular" />
                <Setter Property="TextColor" Value="#2D3748" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="MontserratSemiBold" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="MontserratRegular" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="FontFamily" Value="MontserratRegular" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="MontserratRegular" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="FontFamily" Value="MontserratRegular" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>